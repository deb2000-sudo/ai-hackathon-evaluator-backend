# ==================== Firebase (auth + Firestore) ====================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_DATABASE_URL=your_firebase_database_url
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ==================== Gemini (video analysis) + GCS ====================
# Project that hosts the GCS bucket and Gemini API access.
GOOGLE_CLOUD_PROJECT=your_google_cloud_project
# Gemini API location (use global for enterprise Gemini, us-central1 for Vertex).
GOOGLE_CLOUD_LOCATION=global
# Bucket where uploaded submission videos are stored (must already exist).
EVALUATION_BUCKET_NAME=your_evaluation_bucket_name
# Multimodal Gemini model used to analyze submission videos.
GEMINI_MODEL=gemini-3.5-flash
# Use enterprise Gemini client (matches the VideoAnalyzer prototype).
GEMINI_ENTERPRISE=true
# Expiry (seconds) for signed HTTPS video URLs returned in submission responses.
VIDEO_SIGNED_URL_EXPIRY_SECONDS=3600

# ==================== Application ====================
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production (cross-origin Vercel frontend): set to your frontend URL, e.g.
# ALLOWED_ORIGINS=https://ai-hackathon-evaluator.vercel.app
# Cookie SameSite: lax (local) or none (cross-origin prod + Secure cookie)
COOKIE_SAMESITE=lax

# ==================== Server ====================
HOST=0.0.0.0
PORT=8000
